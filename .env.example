# NEXT_PUBLIC_SUPABASE_URL: Your Supabase Project URL (e.g. https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# NEXT_PUBLIC_SUPABASE_ANON_KEY: Supabase Anon/Public Key for client operations
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# SUPABASE_SERVICE_ROLE_KEY: Supabase Service Role Key (Backend only, never exposed to clients)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
